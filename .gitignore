# =============================================================================
# URDForge Studio .gitignore
# =============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- C extensions & build artifacts ---
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Project runtime output & generated files ---
output/
*.log
*.tmp
temp/
tmp/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Operating System Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- PyInstaller temporary output (keep URDForge.spec tracked) ---
*.manifest
